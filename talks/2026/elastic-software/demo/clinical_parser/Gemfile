source "https://rubygems.org"

# v1/v2 are pure Ruby stdlib — this is the only reason this exercise needs
# a Gemfile at all. squishling's own gemspec pulls in ruby_llm, schematist,
# and json_schemer. Not yet published to RubyGems — git source, pinned to a
# specific commit rather than a branch, so this demo doesn't silently drift
# when the branch (or main) changes underneath it.
#
# Currently pinned to PR #20 (https://github.com/Coolhand-Labs/squishling/pull/20,
# branch `issue-19`), not main: it adds the `:ensemble`/`:judged_ensemble`
# harnesses filed as https://github.com/Coolhand-Labs/squishling/issues/19,
# used by lib/v3/parser_judged_ensemble.rb. Not yet merged — move this back
# to a main commit (last was ce4146bd7bd0c42518142f9402ee5a2282b1e833, which
# predates this PR) once it lands.
gem "squishling", git: "https://github.com/Coolhand-Labs/squishling",
                  ref: "2838ee53c24242ca7c82be7b4dcb558fbddb5f26"

# Zero-config LLM call monitoring: once configured (see bin/run_v3,
# bin/run_v4), it intercepts RubyLLM's outgoing Faraday requests
# automatically, no changes to the squishling classes themselves.
gem "coolhand", "~> 0.7"

# Pinned below 3.x: this machine's json gem native extension (a transitive
# dependency via ruby_llm/faraday) fails to compile against 3.0.2's toolchain
# assumptions. 2.21.2 ships as a prebuilt default gem with this Ruby. See the
# same pin in ../Gemfile.
gem "json", "~> 2.21"

# Pinned: bigdecimal 4.1.3's prebuilt native extension on this machine is
# arm64 while this Ruby runs x86_64 (Rosetta) — "incompatible architecture"
# at load time. A transitive dependency via json_schemer. 4.0.1 loads fine.
gem "bigdecimal", "= 4.0.1"
