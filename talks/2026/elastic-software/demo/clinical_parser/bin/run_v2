#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/run_v2 — runs all 100 fixtures through the v2 dispatcher. Expected:
# 78/100 — the 63 canonical-FHIR fixtures plus the 15 non-FHIR-Bundle ones
# v2 has a class for. The 22 exotic fixtures (079-100) fail with "none of 4
# known formats recognize this record": each would need its own new class.
# ORIGINAL_35=1 restricts the run to the first 35 (35/35 pass).
require "json"
require_relative "../lib/v2/dispatcher"
require_relative "../lib/fixture_manifest"

root = File.expand_path("..", __dir__)
manifest = FixtureManifest.load(root)

passed = 0
failed = 0

manifest.each do |entry|
  raw = File.read(File.join(root, "fixtures", entry.fetch("file")))

  begin
    record = V2::Dispatcher.parse(raw)
    if record.matches?(entry.fetch("expected"))
      passed += 1
      puts "PASS  #{entry.fetch('file')} (#{entry.fetch('format')})"
    else
      failed += 1
      puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — parsed but values don't match expected)"
    end
  rescue V2::UnrecognizedFormatError => e
    failed += 1
    puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — #{e.message})"
  end
end

puts
puts "v2: #{passed}/#{manifest.size} passed, #{failed}/#{manifest.size} failed"
