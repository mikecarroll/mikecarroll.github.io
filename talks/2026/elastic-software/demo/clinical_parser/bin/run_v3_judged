#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/run_v3_judged — V3::ParserJudged (lib/v3/parser_judged.rb): the same
# refined purpose as bin/run_v3, but with the judged_squishsum harness —
# two independent claude-haiku-4-5 samples per fixture, claude-sonnet-5-5
# judging when they disagree. Isolates the harness as the only variable
# against bin/run_v3's 95/100, against all 100 fixtures.
require "bundler/setup"
require "json"
require "squishling"
require "coolhand"
require_relative "../lib/v3/parser_judged"
require_relative "../lib/fixture_manifest"
require_relative "../lib/usage_log"

unless ENV["ANTHROPIC_API_KEY"]
  warn "Set ANTHROPIC_API_KEY before running v3_judged — every fixture here makes 2-3 real LLM calls."
  exit 1
end

RubyLLM.configure { |c| c.anthropic_api_key = ENV["ANTHROPIC_API_KEY"] }

Coolhand.configure do |c|
  c.api_key = ENV["COOLHAND_API_KEY"]
  c.silent = true
end

root = File.expand_path("..", __dir__)
manifest = FixtureManifest.load(root)
usage_log_path = File.join(root, "tmp", "usage_v3_judged.jsonl")

passed = 0
failed = 0
disagreed = 0

UsageLog.open(usage_log_path) do |usage_log|
  Squishling.configure do |c|
    c.default_model = "claude-haiku-4-5-20251001"
    c.default_provider = :anthropic
    c.squawk = UsageLog.squawk_for(usage_log)
  end

  manifest.each do |entry|
    UsageLog.tag(entry.fetch("file"))
    raw = File.read(File.join(root, "fixtures", entry.fetch("file")))

    begin
      record = V3::ParserJudged.parse(raw)
      if record.matches?(entry.fetch("expected"))
        passed += 1
        puts "PASS  #{entry.fetch('file')} (#{entry.fetch('format')})"
      else
        failed += 1
        puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — parsed but values don't match expected)"
      end
    rescue Squishling::DisagreementError => e
      disagreed += 1
      failed += 1
      puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — samples disagreed and the judge rejected both: #{e.message})"
    rescue Squishling::InvalidOutputError => e
      failed += 1
      puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — #{e.message})"
    end
  end
end

puts
puts "v3_judged: #{passed}/#{manifest.size} passed, #{failed}/#{manifest.size} failed " \
     "(#{disagreed} unresolved disagreements)"
puts "usage log: #{usage_log_path}"
