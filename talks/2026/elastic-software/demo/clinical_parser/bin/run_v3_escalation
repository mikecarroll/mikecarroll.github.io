#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/run_v3_escalation — V3::ParserEscalation (lib/v3/parser_escalation.rb):
# the refined purpose, with squishling's default :escalation harness —
# claude-haiku-4-5, escalating to claude-sonnet-5-5 only when the first
# attempt's output is invalid. Pass fixture filenames as ARGV to run just
# those (e.g. the 5 bin/run_v3 misses); with none, runs the full manifest.
require "bundler/setup"
require "json"
require "squishling"
require "coolhand"
require_relative "../lib/v3/parser_escalation"
require_relative "../lib/fixture_manifest"
require_relative "../lib/usage_log"

unless ENV["ANTHROPIC_API_KEY"]
  warn "Set ANTHROPIC_API_KEY before running v3_escalation — every fixture here makes a real LLM call."
  exit 1
end

RubyLLM.configure { |c| c.anthropic_api_key = ENV["ANTHROPIC_API_KEY"] }

Coolhand.configure do |c|
  c.api_key = ENV["COOLHAND_API_KEY"]
  c.silent = true
end

root = File.expand_path("..", __dir__)
manifest = FixtureManifest.load(root)
manifest = manifest.select { |e| ARGV.include?(e.fetch("file")) } if ARGV.any?
usage_log_path = File.join(root, "tmp", "usage_v3_escalation.jsonl")

passed = 0
failed = 0
escalated = 0

UsageLog.open(usage_log_path) do |usage_log|
  Squishling.configure { |c| c.squawk = UsageLog.squawk_for(usage_log) }

  manifest.each do |entry|
    UsageLog.tag(entry.fetch("file"))
    raw = File.read(File.join(root, "fixtures", entry.fetch("file")))

    begin
      record = V3::ParserEscalation.parse(raw)
      if record.matches?(entry.fetch("expected"))
        passed += 1
        puts "PASS  #{entry.fetch('file')} (#{entry.fetch('format')})"
      else
        failed += 1
        puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — parsed but values don't match expected)"
        puts "        expected: #{entry.fetch('expected').to_json}"
        puts "        actual:   #{record.to_h.to_json}"
      end
    rescue Squishling::InvalidOutputError => e
      failed += 1
      puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — #{e.message})"
    end
  end
end

escalated = File.readlines(usage_log_path).count { |line| JSON.parse(line)["model"] == "claude-sonnet-5-5" }

puts
puts "v3_escalation: #{passed}/#{manifest.size} passed, #{failed}/#{manifest.size} failed " \
     "(#{escalated} calls escalated to claude-sonnet-5-5)"
puts "usage log: #{usage_log_path}"
