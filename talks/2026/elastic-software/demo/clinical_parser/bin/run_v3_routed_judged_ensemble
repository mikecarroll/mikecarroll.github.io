#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/run_v3_routed_judged_ensemble — V3::ParserRoutedJudgedEnsemble
# (lib/v3/parser_routed_judged_ensemble.rb): slide 22's router, made real —
# V1::Parser handles canonical FHIR Bundles for free, judged_ensemble
# (Haiku + Sonnet sampled directly, Opus judging on disagreement) handles
# everything V1::UnrecognizedFormatError rejects. Pass fixture filenames as
# ARGV to run just those; with none, the full manifest.
require "bundler/setup"
require "json"
require "squishling"
require "coolhand"
require_relative "../lib/v3/parser_routed_judged_ensemble"
require_relative "../lib/fixture_manifest"
require_relative "../lib/usage_log"

unless ENV["ANTHROPIC_API_KEY"]
  warn "Set ANTHROPIC_API_KEY before running this — fixtures V1 can't parse make real LLM calls."
  exit 1
end

RubyLLM.configure { |c| c.anthropic_api_key = ENV["ANTHROPIC_API_KEY"] }

Coolhand.configure do |c|
  c.api_key = ENV["COOLHAND_API_KEY"]
  c.silent = true
end

root = File.expand_path("..", __dir__)
manifest = FixtureManifest.load(root)
manifest = manifest.select { |e| ARGV.include?(e.fetch("file")) } if ARGV.any?
usage_log_path = File.join(root, "tmp", "usage_v3_routed_judged_ensemble.jsonl")

passed = 0
failed = 0
squished = 0
touched_this_fixture = false

UsageLog.open(usage_log_path) do |usage_log|
  Squishling.configure do |c|
    c.squawk = lambda do |output:, metadata:, error:|
      touched_this_fixture = true
      UsageLog.squawk_for(usage_log).call(output:, metadata:, error:)
    end
  end

  manifest.each do |entry|
    UsageLog.tag(entry.fetch("file"))
    touched_this_fixture = false
    raw = File.read(File.join(root, "fixtures", entry.fetch("file")))

    begin
      record = V3::ParserRoutedJudgedEnsemble.parse(raw)
      squished += 1 if touched_this_fixture
      if record.matches?(entry.fetch("expected"))
        passed += 1
        puts "PASS  #{entry.fetch('file')} (#{entry.fetch('format')})#{' [squished]' if touched_this_fixture}"
      else
        failed += 1
        puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — parsed but values don't match expected)"
      end
    rescue Squishling::InvalidOutputError, Squishling::LLMError => e
      failed += 1
      squished += 1 if touched_this_fixture
      puts "FAIL  #{entry.fetch('file')} (#{entry.fetch('format')} — #{e.message})"
    end
  end
end

routed_free = manifest.size - squished

puts
puts "v3_routed_judged_ensemble: #{passed}/#{manifest.size} passed, #{failed}/#{manifest.size} failed " \
     "(#{routed_free} routed free to V1::Parser, #{squished} squished)"
puts "usage log: #{usage_log_path}"
