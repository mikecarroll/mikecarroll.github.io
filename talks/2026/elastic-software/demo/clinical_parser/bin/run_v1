#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/run_v1 — runs all 100 fixtures through the single v1 parser. Expected:
# the 63 canonical-FHIR fixtures pass; the other 37 (15 original new-format
# fixtures + 22 exotic ones) fail, because v1 was only ever built to
# understand one shape. ORIGINAL_35=1 restricts the run to the first 35
# (20 pass, 15 fail).
require "json"
require_relative "../lib/v1/parser"
require_relative "../lib/fixture_manifest"

root = File.expand_path("..", __dir__)
manifest = FixtureManifest.load(root)

passed = 0
failed = 0

manifest.each do |entry|
  raw = File.read(File.join(root, "fixtures", entry.fetch("file")))

  begin
    record = V1::Parser.new(raw).parse
    if record.matches?(entry.fetch("expected"))
      passed += 1
      puts "PASS  #{entry.fetch('file')}"
    else
      failed += 1
      puts "FAIL  #{entry.fetch('file')} (parsed but values don't match expected)"
    end
  rescue V1::UnrecognizedFormatError => e
    failed += 1
    puts "FAIL  #{entry.fetch('file')} (#{e.message})"
  end
end

puts
puts "v1: #{passed}/#{manifest.size} passed, #{failed}/#{manifest.size} failed"
